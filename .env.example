POSTGRES_DB=lente
POSTGRES_USER=lente
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://lente:change-me-in-production@db:5432/lente
PUBLIC_API_BASE_URL=/api
API_INTERNAL_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000,http://localhost
RAW_DATA_DIR=/data/raw
INGESTION_INTERVAL_SECONDS=86400
INGESTION_SOURCES=ibge,siconfi,cnes
SICONFI_START_YEAR=2022
SICONFI_END_YEAR=2025
SUBMISSION_CAPTCHA_SECRET=replace-with-random-secret
SUBMISSION_FINGERPRINT_SECRET=replace-with-another-random-secret
# Fernet key; without it, optional contact data is rejected and never stored.
CONTACT_ENCRYPTION_KEY=
# OAuth2 token introspection endpoint from an IdP configured to require MFA.
OIDC_INTROSPECTION_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_MFA_REQUIRED=true
CKAN_DISCOVERY_URLS=
DISCOVERY_ALLOWED_HOSTS=
CLAMAV_HOST=
CLAMAV_PORT=3310
DISCOVERY_INTERVAL_SECONDS=86400
DISCOVERY_STALE_DAYS=14

